          "body": "<!DOCTYPE html>\n<html>\n<head><title>Select Brand</title></head>\n<body style=\"font-family:Arial;text-align:center\">\n\n<h1>Select Brand</h1>\n\n<button id=\"brand_a\" onclick=\"openBrand('brandA')\">Brand A</button>\n<button id=\"brand_b\" onclick=\"openBrand('brandB')\">Brand B</button>\n\n<script>\nfunction openBrand(brand){\n window.open(\"/\"+brand,\"_blank\")\n}\n</script>\n\n</body>\n</html>\n",
