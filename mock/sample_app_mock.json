      "endpoint": "brandB",
      "responses": [
        {
          "uuid": "ffe1c9dc-1a0a-461b-84f2-651892ac1527",
          "body": "<!DOCTYPE html>\n<html>\n<head><title>Brand B</title></head>\n<body style=\"font-family:Arial;text-align:center\">\n\n<h1>Brand B Casino</h1>\n\n<h2>Deposit</h2>\n\n<div id=\"eurBlock\">\nEUR: <span id=\"eurBalance\">100</span>\n<button onclick=\"win('EUR')\">Win</button>\n<button onclick=\"loose('EUR')\">Loose</button>\n</div>\n\n<div id=\"usdBlock\" style=\"display:none\">\nUSD: <span id=\"usdBalance\">100</span>\n<button onclick=\"win('USD')\">Win</button>\n<button onclick=\"loose('USD')\">Loose</button>\n</div>\n\n<h2>Payments</h2>\n\n<div id=\"lhvBlock\" style=\"display:none\">\n<button id=\"lhvBtn\">Pay with LHV</button>\n</div>\n\n<div id=\"sebBlock\" style=\"display:none\">\n<button id=\"sebBtn\">Pay with SEB</button>\n</div>\n\n<script>\n\nlet depositState={EUR:100,USD:100}\n\nasync function init(){\n\nconst currencyFlags = await fetch(\"/api/currency-flags\").then(r=>r.json())\nconst paymentFlags = await fetch(\"/api/payments-flags\").then(r=>r.json())\n\nif(currencyFlags.brandB.USD){\n document.getElementById(\"usdBlock\").style.display=\"block\"\n}\n\nif(paymentFlags.brandB.LHV){\n document.getElementById(\"lhvBlock\").style.display=\"block\"\n}\n\nif(paymentFlags.brandB.SEB){\n document.getElementById(\"sebBlock\").style.display=\"block\"\n}\n\n}\n\ninit()\n\nasync function win(currency){\n await fetch(\"/api/win\",{method:\"POST\"})\n depositState[currency]+=10\n update()\n}\n\nasync function loose(currency){\n await fetch(\"/api/loose\",{method:\"POST\"})\n depositState[currency]-=10\n update()\n}\n\nfunction update(){\n document.getElementById(\"eurBalance\").innerText=depositState.EUR\n if(document.getElementById(\"usdBalance\")){\n  document.getElementById(\"usdBalance\").innerText=depositState.USD\n }\n}\n\n</script>\n\n</body>\n</html>\n",
